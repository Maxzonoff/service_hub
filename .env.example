# ─────────────────────────────
# Django
# ─────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ─────────────────────────────
# PostgreSQL
# ─────────────────────────────
POSTGRES_DB=service_hub
POSTGRES_USER=service_hub
POSTGRES_PASSWORD=service_hub_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ─────────────────────────────
# Redis + Celery
# ─────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ─────────────────────────────
# Email (SMTP)
# ─────────────────────────────
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=info@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Service Hub <info@example.com>
ADMIN_EMAIL=admin@example.com

# ─────────────────────────────
# SMS (провайдер: stub | smsru | twilio)
# ─────────────────────────────
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_SENDER=ServiceHub
SMSRU_API_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_PHONE=+79991234567
# ─────────────────────────────
# Безопасность
# ─────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False