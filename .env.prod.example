# ─────────────────────────────
# Django (PROD)
# ─────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=servicehub.ru,www.servicehub.ru
CSRF_TRUSTED_ORIGINS=https://servicehub.ru,https://www.servicehub.ru

# ─────────────────────────────
# PostgreSQL (PROD)
# ─────────────────────────────
POSTGRES_DB=service_hub
POSTGRES_USER=service_hub
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ─────────────────────────────
# Redis + Celery
# ─────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ─────────────────────────────
# Email (PROD)
# ─────────────────────────────
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=info@servicehub.ru
EMAIL_HOST_PASSWORD=change-me-to-email-password
DEFAULT_FROM_EMAIL=Service Hub <info@servicehub.ru>
ADMIN_EMAIL=admin@servicehub.ru

# ─────────────────────────────
# SMS
# ─────────────────────────────
SMS_API_KEY=
SMS_SENDER=ServiceHub

# ─────────────────────────────
# Безопасность (PROD)
# ─────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True